+const normalizeParts = (parts) =>
+  parts.map((part) =>
+    part.type === 'month' && MONTH_NAME_FIXES[part.value]
+      ? { ...part, value: MONTH_NAME_FIXES[part.value] }
+      : part,
+  );
+
