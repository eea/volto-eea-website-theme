+  getUndoState() {
+    const { formData } = this.state;
+    const { selected, multiSelected } = this.props.uiState;
+    const cache = this.undoStateCache;
+    if (
+      cache?.source === formData &&
+      cache.state.selected === selected &&
+      cache.state.multiSelected === multiSelected
+    ) {
+      return cache.state;
+    }
+    this.undoStateCache = {
+      source: formData,
+      state: {
+        formData:
