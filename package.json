{
  "name": "@eeacms/volto-eea-website-theme",
  "version": "4.4.0",
  "description": "@eeacms/volto-eea-website-theme: Volto add-on",
  "main": "src/index.js",
  "author": "European Environment Agency: IDM2 A-Team",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "homepage": "https://github.com/eea/volto-eea-website-theme",
  "keywords": [
    "volto-addon",
    "volto-theme",
    "volto",
    "plone",
    "react"
  ],
  "addons": [
    "@eeacms/volto-anchors",
    "@eeacms/volto-block-toc",
    "@eeacms/volto-group-block",
    "@eeacms/volto-eea-design-system",
    "volto-subsites"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:eea/volto-eea-website-theme.git"
  },
  "dependencies": {
    "@eeacms/volto-anchors": "*",
    "@eeacms/volto-block-style": "*",
    "@eeacms/volto-block-toc": "*",
    "@eeacms/volto-eea-design-system": "*",
    "@eeacms/volto-group-block": "*",
    "@loadable/component": "^5.16.0",
    "clsx": "^2.1.1",
    "react-dnd": "^5.0.0",
    "react-dnd-html5-backend": "^5.0.0",
    "react-portal": "^4.3.0",
    "redux-localstorage-simple": "2.5.1",
    "semantic-ui-less": "2.4.1",
    "volto-subsites": "github:collective/volto-subsites#e0973caa66a164635c4f0976b3f16e10b44d679f"
  },
  "peerDependencies": {
    "@plone/volto": ">=18.0.0 <20.0.0",
    "classnames": ">=2.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-intl": ">=3.0.0",
    "semantic-ui-react": ">=2.0.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-export-default-from": "7.29.7",
    "@babel/plugin-proposal-nullish-coalescing-operator": "7.18.6",
    "@babel/plugin-proposal-throw-expressions": "7.29.7",
    "@babel/plugin-syntax-export-namespace-from": "7.8.3",
    "@cypress/code-coverage": "^3.10.0",
    "@loadable/babel-plugin": "5.16.1",
    "@plone/babel-preset-razzle": "1.0.1",
    "@plone/scripts": "*",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "babel-plugin-lodash": "3.3.4",
    "babel-plugin-react-intl": "5.1.17",
    "babel-plugin-root-import": "6.6.0",
    "babel-plugin-transform-class-properties": "^6.24.1",
    "dotenv": "^16.3.2",
    "eslint-import-resolver-babel-plugin-root-import": "1.1.1",
    "fast-glob": "^3.1.1",
    "husky": "^8.0.3",
    "jsdom": "23.0.0",
    "jsonwebtoken": "9.0.0",
    "lint-staged": "^14.0.1",
    "md5": "^2.3.0",
    "postcss-less": "6.0.0",
    "uuid": "9.0.1",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json}": [
      "make lint-fix",
      "make prettier-fix"
    ],
    "src/**/*.jsx": [
      "make i18n"
    ],
    "theme/**/*.{css,less}": [
      "make stylelint-fix"
    ],
    "src/**/*.{css,less}": [
      "make stylelint-fix"
    ],
    "theme/**/*.overrides": [
      "make stylelint-fix"
    ],
    "src/**/*.overrides": [
      "make stylelint-fix"
    ]
  },
  "scripts": {
    "release": "release-it",
    "release-major-beta": "release-it major --preRelease=beta",
    "release-beta": "release-it --preRelease=beta",
    "bootstrap": "npm install -g ejs; npm link ejs; node bootstrap",
    "test": "vitest --config ./vitest.config.mjs run --passWithNoTests",
    "test:fix": "vitest --config ./vitest.config.mjs run --passWithNoTests --update",
    "pre-commit": "pnpm stylelint:fix && pnpm prettier:fix && pnpm lint:fix",
    "stylelint": "make stylelint",
    "stylelint:overrides": "make stylelint-overrides",
    "stylelint:fix": "make stylelint-fix",
    "prettier": "make prettier",
    "prettier:fix": "make prettier-fix",
    "lint": "make lint",
    "lint:fix": "make lint-fix",
    "i18n": "make i18n",
    "cypress:run": "make cypress-run",
    "cypress:open": "make cypress-open",
    "prepare": "husky install"
  }
}
